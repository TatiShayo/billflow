# ==============================================================================
# BillFlow Environment Variables Example
# Duplicate this file to .env.local and fill in your actual credentials.
# ==============================================================================

# Supabase Configuration (Authentication & Database)
# Public URL of your Supabase project instance
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Public anon key for browser client authentication and RLS queries
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.dummy-anon-key-placeholder
# Service role key (SERVER ONLY - NEVER EXPOSE TO CLIENT) for administrative actions
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.dummy-service-role-key-placeholder

# Stripe Configuration (Subscriptions & Payments)
# Secret API key for server-side Stripe SDK initialization
STRIPE_SECRET_KEY=stripe_test_secret_key_placeholder
# Publishable key for Stripe.js client-side checkout redirection
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key_here
# Stripe Webhook signing secret (from Stripe CLI or Dashboard webhook endpoints)
STRIPE_WEBHOOK_SECRET=stripe_webhook_secret_placeholder
# Stripe recurring Price ID for Pro plan ($8/mo)
NEXT_PUBLIC_STRIPE_PRO_PRICE_ID=price_1DummyProPlanPriceId0000000000
# Stripe recurring Price ID for Business plan ($16/mo)
NEXT_PUBLIC_STRIPE_BUSINESS_PRICE_ID=price_1DummyBizPlanPriceId0000000000

# OpenAI Configuration (AI Invoice Generation)
# OpenAI API key with access to gpt-4o-mini
OPENAI_API_KEY=your_openai_api_key_here

# Resend Configuration (Transactional Emails)
# Resend API key for outbound transactional emails
RESEND_API_KEY=your_resend_api_key_here
# Verified sender email or default test email
RESEND_FROM_EMAIL=onboarding@resend.dev

# Application Public URL (Used in email pay links, callbacks, and redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000
